# ==============================================
# Atomic Link Ticket System - 環境変数設定
# ==============================================
# このファイルをコピーして .env を作成してください
# cp .env.example .env

# --- アプリケーション設定 ---
APP_ENV=dev
APP_DEBUG=1

# --- データベース設定 ---
DATABASE_URL=mysql://dbuser:secret@mysql/eccubedb
DATABASE_SERVER_VERSION=8
DATABASE_CHARSET=utf8mb4

# --- EC-CUBE 管理画面 ---
# 初回インストール時に設定される管理者アカウント
ECCUBE_ADMIN_USER=admin
ECCUBE_ADMIN_PASS=password

# --- EC-CUBE ロケール設定 ---
ECCUBE_LOCALE=ja
ECCUBE_TIMEZONE=Asia/Tokyo
ECCUBE_CURRENCY=JPY

# --- メール設定（開発環境: MailCatcher） ---
MAILER_DSN=smtp://mailcatcher:1025

# --- セキュリティ ---
ECCUBE_AUTH_MAGIC=atomiclink2026ticket

# --- MySQL 設定 ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=eccubedb
MYSQL_USER=dbuser
MYSQL_PASSWORD=secret
